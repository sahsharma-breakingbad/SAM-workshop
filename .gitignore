# macOS Finder junk
.DS_Store

# Workshop credentials (created from env.example - holds real secrets)
.env

# Working / review documents - not part of the workshop deliverable
GIT_FIXES.md
UPDATED README.md

# Python virtualenvs and bytecode (created by the local-Python runtime option)
.venv/
__pycache__/
*.pyc

# Editor / IDE state
.idea/
.vscode/

# Go build outputs — compiled binaries live in toolsets/ zips, not source tree
travel-planner/src/dist/

# Go dependency lock (generated on build)
travel-planner/src/go.sum
travel-planner/src/_sdk/samtoolsdk/go.sum

# SSH keys — never commit
*.pem
